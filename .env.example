# AI Engineer environment — copy to .env (never commit .env).
# Only set the providers you use. Keys are read from the environment; they are
# never written to config files, logs, traces, reports or commits, and they are
# stripped from the environment of commands the agent runs.

# --- Hosted providers (auto-detected when set) ---------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Local / self-hosted models (work offline) ----------------------------------
# Ollama (default http://localhost:11434):
# OLLAMA_HOST=http://localhost:11434
# Any OpenAI-compatible server (vLLM, llama.cpp server, LM Studio, ...):
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# --- Which models to use ----------------------------------------------------------
# A comma-separated fallback chain of provider:model. List the ids your providers
# offer with:  aie providers models
# AIE_MODEL=anthropic:<model-id>,ollama:<model-id>
# Optional independent reviewer and a cheap model for classification:
# AIE_REVIEW_MODEL=openai:<model-id>
# AIE_FAST_MODEL=ollama:<model-id>

# --- Behaviour ------------------------------------------------------------------------
# safe | assisted | developer | autonomous
# AIE_MODE=developer
# Any setting can be overridden as AIE__SECTION__KEY, e.g.:
# AIE__AGENT__MAX_STEPS=80
# AIE__VALIDATION__TEST_COMMAND="python -m pytest -q"

# --- Web dashboard ------------------------------------------------------------------------
# Fixed access token (otherwise a random one is printed at startup):
# AIE_WEB_TOKEN=

# --- Global state location (memory across projects, global config) ---------------------
# AIE_HOME=~/.config/ai-engineer
